{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v0.7.0 fixed routes",
  "type": "object",
  "required": ["schema_version", "content_version", "base_cards_version", "base_encounters_version", "default_route_id", "routes"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "content_version": {"type": "string", "minLength": 1},
    "base_cards_version": {"type": "string", "minLength": 1},
    "base_encounters_version": {"type": "string", "minLength": 1},
    "default_route_id": {"type": "string", "pattern": "^route\\."},
    "routes": {
      "type": "array",
      "minItems": 1,
      "x-uniqueBy": "id",
      "items": {
        "type": "object",
        "required": ["id", "display_name_zh", "initial_run_state", "sequence", "rest_options", "nodes"],
        "properties": {
          "id": {"type": "string", "pattern": "^route\\."},
          "display_name_zh": {"type": "string", "minLength": 1},
          "initial_run_state": {"type": "object"},
          "sequence": {"type": "object", "required": ["pathway_id", "pathway_name_zh", "current_sequence", "next_sequence", "next_sequence_name_zh"]},
          "rest_options": {
            "type": "array",
            "minItems": 2,
            "x-uniqueBy": "id",
            "items": {
              "type": "object",
              "required": ["id", "display_name_zh", "description_zh", "effects"],
              "properties": {
                "id": {"type": "string", "pattern": "^rest\\."},
                "display_name_zh": {"type": "string", "minLength": 1},
                "description_zh": {"type": "string"},
                "effects": {"type": "object"}
              }
            }
          },
          "nodes": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "x-uniqueBy": "id",
            "items": {
              "type": "object",
              "required": ["id", "type", "display_name_zh"],
              "properties": {
                "id": {"type": "string", "pattern": "^route\\..+\\.node\\."},
                "type": {"type": "string", "enum": ["normal", "elite", "rest", "boss", "ritual"]},
                "display_name_zh": {"type": "string", "minLength": 1},
                "encounter_id": {"type": "string", "pattern": "^encounter\\."},
                "ritual_id": {"type": "string", "pattern": "^ritual\\."}
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
