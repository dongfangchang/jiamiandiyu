{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v0.7.0 global balance",
  "type": "object",
  "required": ["schema_version", "content_version", "player", "combat", "progression", "gacha", "upgrade", "reward"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 2},
    "content_version": {"type": "string", "minLength": 1},
    "status": {"type": "string"},
    "player": {
      "type": "object",
      "required": ["max_health", "starting_health", "spirit_per_turn", "starting_hand", "turn_draw_to_hand_size", "max_hand_size", "corruption", "attention"]
    },
    "combat": {
      "type": "object",
      "required": ["max_rounds", "enemy_pressure", "chain"],
      "properties": {
        "chain": {
          "type": "object",
          "required": ["threshold", "damage", "draw", "spirit"],
          "properties": {
            "threshold": {"type": "integer", "minimum": 1},
            "damage": {"type": "integer", "minimum": 0},
            "draw": {"type": "integer", "minimum": 0},
            "spirit": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "progression": {"type": "object"},
    "gacha": {"type": "object"},
    "upgrade": {"type": "object"},
    "reward": {"type": "object"},
    "route": {"type": "object"},
    "challenge": {"type": "object"}
  },
  "additionalProperties": true
}
