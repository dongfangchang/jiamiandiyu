{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v0.7.0 global balance",
  "type": "object",
  "required": ["schema_version", "content_version", "player", "combat", "progression", "gacha", "upgrade", "reward"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 2},
    "content_version": {"type": "string", "minLength": 1},
    "status": {"type": "string"},
    "player": {
      "type": "object",
      "required": ["max_health", "starting_health", "spirit_per_turn", "starting_hand", "turn_draw_to_hand_size", "max_hand_size", "corruption", "attention"]
    },
    "combat": {
      "type": "object",
      "required": ["max_rounds", "enemy_pressure", "chain", "danger_threshold", "rules"],
      "properties": {
        "enemy_pressure": {
          "type": "object",
          "required": ["start_round", "interval_rounds", "trigger_count", "bonus_per_trigger"],
          "properties": {
            "start_round": {"type": "integer", "minimum": 1},
            "interval_rounds": {"type": "integer", "minimum": 1},
            "trigger_count": {"type": "integer", "minimum": 1},
            "bonus_per_trigger": {"type": "integer", "minimum": 1}
          }
        },
        "danger_threshold": {"type": "integer", "minimum": 1},
        "rules": {
          "type": "object",
          "required": ["ritual_max_stacks", "danger_intent_corruption_at", "foresight_reduction", "attention_bonus_at_hunter", "attention_bonus_at_max", "corruption_round_hp_loss", "threat_risk"],
          "properties": {
            "ritual_max_stacks": {"type": "integer", "minimum": 1},
            "danger_intent_corruption_at": {"type": "integer", "minimum": 0},
            "foresight_reduction": {"type": "integer", "minimum": 0},
            "attention_bonus_at_hunter": {"type": "integer", "minimum": 0},
            "attention_bonus_at_max": {"type": "integer", "minimum": 0},
            "corruption_round_hp_loss": {"type": "integer", "minimum": 0},
            "threat_risk": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
          }
        },
        "chain": {
          "type": "object",
          "required": ["threshold", "damage", "draw", "spirit"],
          "properties": {
            "threshold": {"type": "integer", "minimum": 1},
            "damage": {"type": "integer", "minimum": 0},
            "draw": {"type": "integer", "minimum": 0},
            "spirit": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "progression": {"type": "object"},
    "gacha": {"type": "object"},
    "upgrade": {"type": "object"},
    "reward": {"type": "object"},
    "route": {
      "type": "object",
      "required": ["spirit_wipe_cost", "pen_rewrite", "defeat_penalty", "ritual_soft_fail_corruption_margin", "default_run_state"],
      "properties": {
        "spirit_wipe_cost": {"type": "integer", "minimum": 0},
        "pen_rewrite": {
          "type": "object",
          "required": ["every_n", "phase"],
          "properties": {
            "every_n": {"type": "integer", "minimum": 1},
            "phase": {"type": "integer", "minimum": 0}
          }
        },
        "defeat_penalty": {
          "type": "object",
          "required": ["corruption", "attention"],
          "properties": {
            "corruption": {"type": "integer", "minimum": 0},
            "attention": {"type": "integer", "minimum": 0}
          }
        },
        "ritual_soft_fail_corruption_margin": {"type": "integer", "minimum": 0},
        "default_run_state": {
          "type": "object",
          "required": ["hp", "max_hp", "spirit", "max_spirit", "corruption", "max_corruption", "attention", "max_attention"]
        }
      }
    },
    "challenge": {"type": "object"}
  },
  "additionalProperties": true
}
