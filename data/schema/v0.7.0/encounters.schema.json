{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v0.7.0 encounter definitions",
  "type": "object",
  "required": ["schema_version", "content_version", "base_cards_version", "encounters"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "content_version": {"type": "string", "minLength": 1},
    "base_cards_version": {"type": "string", "minLength": 1},
    "encounters": {
      "type": "array",
      "minItems": 1,
      "x-uniqueBy": "id",
      "items": {
        "type": "object",
        "required": ["id", "display_name_zh", "deck_definition_ids", "enemy_slots"],
        "properties": {
          "id": {"type": "string", "pattern": "^encounter\\."},
          "display_name_zh": {"type": "string", "minLength": 1},
          "tier": {"type": "string", "enum": ["normal", "elite", "boss"]},
          "deck_definition_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^card\\."}
          },
          "enemy_slots": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["enemy_id", "lane_index"],
              "properties": {
                "enemy_id": {"type": "string", "pattern": "^enemy\\."},
                "lane_index": {"type": "integer", "minimum": 0, "maximum": 2}
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
