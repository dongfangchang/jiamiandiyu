{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v0.7.0 enemy definitions with phases",
  "type": "object",
  "required": ["schema_version", "content_version", "base_cards_version", "enemies"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "content_version": {"type": "string", "minLength": 1},
    "base_cards_version": {"type": "string", "minLength": 1},
    "enemies": {
      "type": "array",
      "minItems": 1,
      "x-uniqueBy": "id",
      "items": {
        "type": "object",
        "required": ["id", "display_name_zh", "tier", "base_health", "base_attack"],
        "properties": {
          "id": {"type": "string", "pattern": "^enemy\\."},
          "display_name_zh": {"type": "string", "minLength": 1},
          "tier": {"type": "string", "enum": ["normal", "elite", "boss"]},
          "base_health": {"type": "integer", "minimum": 1},
          "base_attack": {"type": "integer", "minimum": 0},
          "threat": {"type": "string"},
          "phases": {
            "type": "array",
            "x-uniqueBy": "id",
            "items": {
              "type": "object",
              "required": ["id", "display_name_zh", "at_round", "base_attack_bonus", "block_bonus", "heal"],
              "properties": {
                "id": {"type": "string", "pattern": "^phase\\."},
                "display_name_zh": {"type": "string", "minLength": 1},
                "at_round": {"type": "integer", "minimum": 1},
                "base_attack_bonus": {"type": "integer", "minimum": 0},
                "block_bonus": {"type": "integer", "minimum": 0},
                "heal": {"type": "integer", "minimum": 0}
              }
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
