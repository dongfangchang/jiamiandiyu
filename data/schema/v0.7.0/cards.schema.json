{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v0.7.0 seer battle cards",
  "type": "object",
  "required": ["schema_version", "content_version", "cards"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "content_version": {"type": "string", "minLength": 1},
    "cards": {
      "type": "array",
      "minItems": 16,
      "x-uniqueBy": "id",
      "items": {
        "type": "object",
        "required": ["id", "display_name_zh", "category", "cost_spirit", "target_type", "effects"],
        "properties": {
          "id": {"type": "string", "pattern": "^card\\."},
          "display_name_zh": {"type": "string", "minLength": 1},
          "description_zh": {"type": "string"},
          "category": {"type": "string", "enum": ["identity", "skill", "artifact", "echo"]},
          "cost_spirit": {"type": "integer", "minimum": 0, "maximum": 3},
          "target_type": {"type": "string", "enum": ["none", "self", "enemy"]},
          "effects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["effect_id"],
              "properties": {
                "effect_id": {
                  "type": "string",
                  "enum": ["damage", "block", "heal", "draw", "spirit", "apply_status", "remove_status", "discard", "reveal_intent", "risk"]
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
