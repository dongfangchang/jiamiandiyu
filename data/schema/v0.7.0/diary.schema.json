{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "diary volume (pages + 0-08 annotations)",
  "type": "object",
  "required": ["schema_version", "content_version", "volume_id", "route_id", "pages", "annotations"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 2},
    "content_version": {"type": "string", "minLength": 1},
    "volume_id": {"type": "string", "minLength": 1},
    "route_id": {"type": "string", "minLength": 1},
    "display_name_zh": {"type": "string"},
    "carrier_zh": {"type": "string"},
    "pen_zh": {"type": "string"},
    "base_notes_zh": {"type": "array", "items": {"type": "string"}},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["clues"],
        "properties": {
          "page_index": {"type": "integer", "minimum": 0},
          "title_zh": {"type": "string"},
          "spread_label_zh": {"type": "string"},
          "clues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["clue_id", "node_id"],
              "properties": {
                "clue_id": {"type": "string", "minLength": 1},
                "node_id": {"type": "string", "minLength": 1},
                "kind": {"type": "string", "minLength": 1},
                "text_zh": {"type": "string"},
                "margin_note_zh": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "annotations": {
      "type": "object",
      "required": ["pools", "fixed", "entries"],
      "additionalProperties": false,
      "properties": {
        "pools": {
          "type": "object",
          "required": ["pen_rewrite", "victory", "defeat", "reink", "rest", "wipe"],
          "additionalProperties": {
            "type": "object",
            "required": ["cycle"],
            "additionalProperties": false,
            "properties": {
              "by_node": {
                "type": "object",
                "additionalProperties": {"type": "string", "pattern": "^annotation\\."}
              },
              "cycle": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "pattern": "^annotation\\."}
              },
              "default": {"type": "string", "pattern": "^annotation\\."}
            }
          }
        },
        "fixed": {
          "type": "object",
          "required": ["pen_rewrite_marker", "pen_rewrite_margin", "ritual_failed"],
          "additionalProperties": {"type": "string", "pattern": "^annotation\\."}
        },
        "entries": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["text_zh", "ink_stain"],
            "additionalProperties": false,
            "properties": {
              "text_zh": {"type": "string", "minLength": 1},
              "ink_stain": {"type": "boolean"}
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
