{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v0.6.0 challenge definitions",
  "type": "object",
  "required": [
    "schema_version",
    "content_version",
    "base_route_version",
    "default_challenge_id",
    "challenges"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "content_version": {
      "type": "string",
      "minLength": 1
    },
    "base_route_version": {
      "type": "string",
      "minLength": 1
    },
    "default_challenge_id": {
      "type": "string",
      "pattern": "^challenge\\."
    },
    "challenges": {
      "type": "array",
      "minItems": 1,
      "x-uniqueBy": "id",
      "items": {
        "type": "object",
        "required": [
          "id",
          "display_name_zh",
          "description_zh",
          "route_id",
          "required_sequence",
          "completion_reward",
          "modifiers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^challenge\\."
          },
          "display_name_zh": {
            "type": "string",
            "minLength": 1
          },
          "description_zh": {
            "type": "string"
          },
          "route_id": {
            "type": "string",
            "pattern": "^route\\."
          },
          "required_sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          "completion_reward": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "modifiers": {
            "type": "array",
            "minItems": 3,
            "x-uniqueBy": "id",
            "items": {
              "type": "object",
              "required": ["id", "display_name_zh", "description_zh", "effects"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^modifier\\."
                },
                "display_name_zh": {
                  "type": "string",
                  "minLength": 1
                },
                "description_zh": {
                  "type": "string"
                },
                "effects": {
                  "type": "object",
                  "minProperties": 1,
                  "properties": {
                    "phase_round_delta": {
                      "type": "integer",
                      "minimum": -9,
                      "maximum": 9
                    },
                    "starting_corruption_delta": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10
                    },
                    "starting_attention_delta": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10
                    },
                    "battle_corruption_delta": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10
                    },
                    "starting_max_spirit_delta": {
                      "type": "integer",
                      "minimum": -5,
                      "maximum": 5
                    },
                    "remove_definition_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^card\\."
                      }
                    },
                    "completion_reward": {
                      "type": "object",
                      "minProperties": 1,
                      "additionalProperties": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
