{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v0.5.0 local save with route checkpoint",
  "type": "object",
  "required": [
    "save_version",
    "content_version",
    "created_at",
    "rng_seed",
    "profile",
    "run",
    "collection",
    "progression",
    "route"
  ],
  "properties": {
    "save_version": {"type": "integer", "minimum": 1},
    "content_version": {"type": "string", "minLength": 1},
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    },
    "rng_seed": {"type": "integer"},
    "profile": {
      "type": "object",
      "required": ["pathway", "sequence"],
      "properties": {
        "pathway": {"type": "string"},
        "sequence": {"type": "integer", "minimum": 1},
        "identity_id": {"type": "string"}
      }
    },
    "run": {
      "type": "object",
      "required": ["checkpoint_kind"],
      "properties": {
        "checkpoint_kind": {"type": "string"},
        "encounter_id": {"type": "string"},
        "current_node_id": {"type": "string"},
        "deck_summary": {"type": "object"},
        "last_battle": {"type": "object"}
      }
    },
    "collection": {"type": "object"},
    "progression": {
      "type": "object",
      "required": [
        "phase",
        "identity_id",
        "divination_tickets",
        "collection",
        "pity_counter",
        "reward_option_ids",
        "last_battle_outcome",
        "last_gacha_results",
        "revision"
      ]
    },
    "route": {
      "type": "object",
      "required": [
        "initialized",
        "route_id",
        "phase",
        "run_state",
        "completed_node_ids",
        "sequence_state",
        "state"
      ],
      "properties": {
        "initialized": {"type": "boolean"},
        "route_id": {"type": "string"},
        "phase": {"type": "string"},
        "run_state": {"type": "object"},
        "completed_node_ids": {"type": "array"},
        "sequence_state": {"type": "string"},
        "state": {"type": "object"}
      }
    }
  },
  "additionalProperties": true
}
