{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local save envelope",
  "type": "object",
  "required": [
    "save_version",
    "content_version",
    "created_at",
    "rng_seed",
    "profile",
    "run",
    "collection"
  ],
  "properties": {
    "save_version": {
      "type": "integer",
      "minimum": 0
    },
    "content_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    },
    "rng_seed": {
      "type": "integer"
    },
    "profile": {
      "type": "object"
    },
    "run": {
      "type": "object"
    },
    "collection": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
