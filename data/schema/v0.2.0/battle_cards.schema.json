{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v0.2.0 battle card content",
  "type": "object",
  "required": [
    "schema_version",
    "content_version",
    "cards"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "content_version": {
      "type": "string",
      "minLength": 1
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "x-uniqueBy": "id",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "cost_spirit",
          "target_type",
          "effects"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^card\\."
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "cost_spirit": {
            "type": "integer",
            "minimum": 0
          },
          "target_type": {
            "type": "string",
            "enum": [
              "none",
              "self",
              "enemy"
            ]
          },
          "effects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "effect_id"
              ],
              "properties": {
                "effect_id": {
                  "type": "string",
                  "enum": [
                    "damage",
                    "block",
                    "heal",
                    "draw",
                    "spirit",
                    "apply_status",
                    "remove_status",
                    "discard",
                    "reveal_intent",
                    "risk"
                  ]
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
