{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content manifest",
  "type": "object",
  "required": ["schema_version", "content_revision", "documents"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "content_revision": {"type": "integer", "minimum": 1},
    "description": {"type": "string"},
    "documents": {
      "type": "object",
      "required": ["cards", "progression", "enemies", "encounters", "balance", "routes", "rituals", "challenges", "decks", "diary"],
      "additionalProperties": {
        "type": "object",
        "required": ["path", "schema"],
        "properties": {
          "path": {"type": "string", "pattern": "^res://data/.+\\.json$"},
          "schema": {"type": "string", "pattern": "^res://data/schema/.+\\.schema\\.json$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
