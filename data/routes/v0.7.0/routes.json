      "nodes": [
        {
          "id": "route.v028.first_stage.node.first_hunt",
          "type": "normal",
          "display_name_zh": "密修会的闯入者",
          "encounter_id": "encounter.first_hunt",
          "chapter_phase": "discovery",
          "narrative_beat_zh": "刚加入值夜者的第三天，一名密修会成员潜入莫雷蒂家，觊觎与安提哥努斯家族笔记有关的线索。",
          "investigation_goal_zh": "用左轮守住家门，撑到值夜者赶来。",
          "reward_hint_zh": "熟悉基础操作：选牌、选目标、结束回合。",
          "source_zh": "第一卷 6月30日"
        },
        {
          "id": "route.v028.first_stage.node.tenant_trace",
          "type": "normal",
          "display_name_zh": "艾略特绑架案",
          "encounter_id": "encounter.v028.tenant_trace",
          "chapter_phase": "evidence",
          "narrative_beat_zh": "灵摆指向一栋废弃建筑，被绑架的小艾略特就在里面。",
          "investigation_goal_zh": "击退两波普通绑匪；占卜家没有战斗强化，先看清意图再出手。",
          "reward_hint_zh": "连续波次：第一波清空后才会出现下一波。",
          "source_zh": "第一卷 7月6日"
        },
        {
          "id": "route.v028.first_stage.node.mirror_pursuit",
          "type": "elite",
          "display_name_zh": "提利尔仓库",
          "encounter_id": "encounter.mirror_pursuit",
          "chapter_phase": "pursuit",
          "narrative_beat_zh": "2-049被送到廷根追查瑞尔·比伯；密修会的燕尾服小丑尾随而来，所有人都被木偶减缓了动作。",
          "investigation_goal_zh": "先解决失控的瑞尔·比伯，再面对燕尾服小丑；用2-049控制他，然后开枪。",
          "reward_hint_zh": "原著联动“提利尔仓库”：2-049 + 左轮/猎魔子弹。",
          "source_zh": "第一卷 7月12日"
        },
        {
          "id": "route.v028.first_stage.node.boundary",
          "type": "normal",
          "display_name_zh": "伍德家的恶灵",
          "encounter_id": "encounter.v028.boundary",
          "chapter_phase": "threshold",
          "narrative_beat_zh": "赛琳娜·伍德的生日宴上，女孩们玩起魔镜占卜，招来的恶灵附在了她身上。",
          "investigation_goal_zh": "以灵性之墙与驱邪仪式驱除恶灵。",
          "reward_hint_zh": "原著联动“伍德家驱灵”：驱邪仪式 + 魔镜占卜/灵视。",
          "source_zh": "第一卷 7月15日"
        },
        {
          "id": "route.v028.first_stage.node.rest",
          "type": "rest",
          "display_name_zh": "占卜俱乐部",
          "chapter_phase": "preparation",
          "narrative_beat_zh": "占卜家守则：帮助别人解读启示，但不能完全依赖占卜。克莱恩在豪尔斯街的俱乐部里扮演、消化。",
          "investigation_goal_zh": "选择包扎伤口，或以扮演法消化魔药、压低污染。",
          "reward_hint_zh": "扮演会推进魔药消化，但也会带来更多注视。",
          "source_zh": "第一卷 7月8日起"
        },
        {
          "id": "route.v028.first_stage.node.lamud",
          "type": "elite",
          "display_name_zh": "拉姆德小镇驱邪",
          "encounter_id": "encounter.v070.twin_pursuit",
          "chapter_phase": "pursuit",
          "narrative_beat_zh": "伊丽莎白的噩梦来自拉姆德小镇的一具黑色骑士铠甲。邓恩申请取出3-0782，带着克莱恩与弗莱前往驱邪。",
          "investigation_goal_zh": "在骑士怨魂缩回铠甲前，以净化力量将其驱散。",
          "reward_hint_zh": "原著联动“拉姆德小镇驱邪”：3-0782 + 灵视/通灵。",
          "source_zh": "第一卷 8月19日"
        },
        {
          "id": "route.v028.first_stage.node.baron",
          "type": "boss",
          "display_name_zh": "失控的老尼尔",
          "encounter_id": "encounter.mirror_baron",
          "chapter_phase": "confrontation",
          "narrative_beat_zh": "教导克莱恩神秘学的老尼尔，在隐匿贤者的耳语下试图复活亡妻，最终失控成了怪物。",
          "investigation_goal_zh": "在他彻底异变前，用安静发丝让他安静下来。",
          "reward_hint_zh": "原著联动“可怜虫”：3-0611 + 左轮/猎魔子弹。胜利后获得小丑魔药。",
          "source_zh": "第一卷 8月29日"
        },
        {
          "id": "route.v028.first_stage.node.ascension",
          "type": "ritual",
          "display_name_zh": "晋升：小丑",
          "ritual_id": "ritual.v070.tampered_obituary",
          "chapter_phase": "advancement",
          "narrative_beat_zh": "老尼尔下葬两天后，克莱恩通过了克雷斯泰·塞西玛的考核，向黑夜女神起誓不泄露扮演法。",
          "investigation_goal_zh": "回答扮演法与晋升流程的三个问题，确认可以服用小丑魔药。",
          "reward_hint_zh": "完成后获得小丑魔药；消化度足够即可在结算页服用并晋升。",
          "source_zh": "第一卷 8月25日—31日"
        }
      ]
    }
  ]
