{
  "manifest_version": 1,
  "source_dir": "res://art/assets/raster/v0.85.0/props",
  "output_dir": "res://assets/ui/diary/props",
  "_doc": {
    "key": "flood_dark = 从边界洪水填充扣掉深色底；flood_light = 扣掉浅色底；none = 整幅材质不抠图",
    "tolerance": "与背景采样色的距离阈值(0-1)，越大扣得越狠",
    "feather": "边缘羽化像素，消锯齿",
    "trim": "true = 裁掉透明边并按 pad 留边",
    "添加新素材": "在 props[] 里加一行，把文件放进 source_dir，再跑 art/tools/key_props.tscn",
    "variants": "从同一张源图派生多个着色版本（如蜡封三态），避免美术重画三遍",
    "also_out": "额外输出路径，用于喂给已经写死某路径的代码"
  },
  "props": [
    {
      "id": "desk_wood",
      "src": "prop-desk-wood.png",
      "key": "none",
      "out": "desk-wood.png",
      "also_out": [
        "res://assets/ui/diary/desk_wood.png"
      ]
    },
    {
      "id": "parchment_sheet",
      "src": "prop-parchment-sheet.png",
      "key": "flood_dark",
      "tolerance": 0.16,
      "feather": 2,
      "trim": true,
      "out": "parchment-sheet.png"
    },
    {
